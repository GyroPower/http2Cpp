{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch http2 server example release codelldb",
      "type": "codelldb",
      "request": "launch",
      "program": "${workspaceFolder}/example/server/build/Release/http2_server_byPower",
      "args": [
        "-p",
        "8082",
        "--https",
        "false",
        "-t",
        "2",
        "--pk",
        "localhost+2.pem",
        "-k",
        "localhost+2-key.pem"
      ],
      "cwd": "${workspaceFolder}/example/server/",
      "console": "integratedTerminal",
      "stopOnEntry": false
    },
